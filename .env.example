# Salin menjadi .env lalu isi nilainya:  cp .env.example .env

# Password database PostgreSQL (buat string acak panjang)
DB_PASSWORD=ganti-password-db

# Kunci rahasia untuk token login dashboard (mis. hasil: openssl rand -hex 32)
SECRET_KEY=ganti-dengan-hasil-openssl-rand-hex-32

# Domain website mitra yang boleh mengirim data (dipisah koma)
ALLOWED_ORIGINS=https://ysii.org,https://www.ysii.org
# URL publik API ini
PUBLIC_API_URL=https://api.ysii.org
# Domain untuk sertifikat HTTPS (dipakai nginx)
API_DOMAIN=api.ysii.org

# Nomor WhatsApp admin (format 62...)
WHATSAPP_ADMIN=6281234567890

# Batas segmen skor
HOT_THRESHOLD=0.7
WARM_THRESHOLD=0.4
# Contoh positif minimal sebelum model ML menggantikan skor berbasis aturan
MIN_POSITIVE_SAMPLES=30

# Google Search Console (opsional): letakkan kunci service account di ./secrets/gsc-sa.json
GSC_SITE_URL=sc-domain:ysii.org
GSC_CREDENTIALS_FILE=

# Notifikasi lead HOT (opsional): URL webhook (n8n, Make, Fonnte, Slack, dll.)
HOT_LEAD_WEBHOOK_URL=
