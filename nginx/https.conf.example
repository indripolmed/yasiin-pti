# Setelah sertifikat terbit, salin file ini menjadi nginx/templates/https.inc.template
# lalu restart nginx:  docker compose restart nginx
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_types text/javascript application/javascript text/css application/json;

    location /static/ {
        proxy_pass http://$api_upstream;
        expires 1h;
        add_header Cache-Control "public";
        # add_header di dalam location menggantikan yang di level server, jadi diulang di sini
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
